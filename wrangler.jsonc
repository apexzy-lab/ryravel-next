{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ryravel-feeling-journeys",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.js",
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true },
  "vars": { "OPS_ALERT_EMAIL": "support@ryravel.com" },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ryravel-enquiries",
      "database_id": "795e7329-4e55-4a2c-b4a1-718a27a9146f",
      "migrations_dir": "drizzle"
    }
  ]
}
